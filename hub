-- ============================================================================

-- 1. Infinite Jump
local infJumpEnabled = false
Tabs.Movement:AddToggle("InfJumpToggle", {
    Title = "Бесконечный прыжок",
    Default = false
}):OnChanged(function(Value)
    infJumpEnabled = Value
end)

