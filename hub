-- 2. CFrame Speed Hack
local speedEnabled = false
local speedMultiplier = 16

Tabs.Movement:AddToggle("SpeedToggle", {
    Title = "CFrame Спидхак",
    Default = false
}):OnChanged(function(Value)
    speedEnabled = Value
end)

Tabs.Movement:AddSlider("SpeedSlider", {
    Title = "Множитель скорости",
    Description = "Безопасное изменение позиции через дельта-интерполяцию",
    Default = 16,
    Min = 16,
    Max = 100,
    Rounding = 1,
    Callback = function(Value)
        speedMultiplier = Value
    end
})

table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
    if speedEnabled then
        local _, humanoid, rootPart = getCharacterData(LocalPlayer)
        if humanoid and rootPart and humanoid.MoveDirection.Magnitude > 0 then
            pcall(function()
                rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * (speedMultiplier * dt))
            end)
        end
    end
end))

-- 3. Camera-Steered Flight
local flightEnabled = false
local flightSpeed = 50

Tabs.Movement:AddToggle("FlightToggle", {
    Title = "Полет по камере",
    Default = false
}):OnChanged(function(Value)
    flightEnabled = Value
    local _, humanoid, _ = getCharacterData(LocalPlayer)
    if humanoid then
        humanoid.PlatformStand = Value
    end
end)

Tabs.Movement:AddSlider("FlightSpeedSlider", {
    Title = "Скорость полета",
    Default = 50,
    Min = 10,
    Max = 200,
    Rounding = 1,
    Callback = function(Value)
        flightSpeed = Value
    end
})

table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    if flightEnabled then
        local _, humanoid, rootPart = getCharacterData(LocalPlayer)
        if humanoid and rootPart then
            pcall(function()
                humanoid.PlatformStand = true
                local moveDir = Vector3.new()
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

                if moveDir.Magnitude > 0 then
                    moveDir = moveDir.Unit
                end

                rootPart.Velocity = Vector3.new(0, 0, 0)
                rootPart.CFrame = rootPart.CFrame + (moveDir * (flightSpeed * dt))
            end)
        end
    else
        local _, humanoid, _ = getCharacterData(LocalPlayer)
        if humanoid and humanoid.PlatformStand then
            pcall(function()
                humanoid.PlatformStand = false
            end)
        end
    end
end))

