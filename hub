-- Хранилище графических примитивов Drawing для игроков
local ESPFolder = {}

local function createESP(player)
    if ESPFolder[player] then return end
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(0, 255, 128)
    box.Thickness = 1.5
    box.Filled = false

    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Color = Color3.fromRGB(0, 255, 128)
    tracer.Thickness = 1.5

    ESPFolder[player] = { Box = box, Tracer = tracer }
end

local function removeESP(player)
    if ESPFolder[player] then
        pcall(function()
            if ESPFolder[player].Box then ESPFolder[player].Box:Remove() end
            if ESPFolder[player].Tracer then ESPFolder[player].Tracer:Remove() end
        end)
        ESPFolder[player] = nil
    end
end

-- Инициализация для текущих игроков на сервере
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        createESP(player)
    end
end

table.insert(Connections, Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        createESP(player)
    end
end))

table.insert(Connections, Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
end))

-- Рендер-луп для высокопроизводительного обновления ESP
table.insert(Connections, RunService.RenderStepped:Connect(function()
    if not espEnabled then return end

    for player, data in pairs(ESPFolder) do
        local char, humanoid, rootPart = getCharacterData(player)
        local box, tracer = data.Box, data.Tracer

        if char and rootPart and humanoid and humanoid.Health > 0 then
            local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

            if onScreen then
                local distance = (Camera.CFrame.Position - rootPart.Position).Magnitude
                local scale = 1 / (distance * 0.05) * 50
                local width = math.clamp(22 * scale, 15, 120)
                local height = math.clamp(40 * scale, 30, 200)

                -- Обновление Box ESP
                if boxEspEnabled then
                    box.Visible = true
                    box.Size = Vector2.new(width, height)
                    box.Position = Vector2.new(vector.X - width / 2, vector.Y - height / 2)
                else
                    box.Visible = false
                end

                -- Обновление Tracer ESP
                if tracerEspEnabled then
                    tracer.Visible = true
                    tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracer.To = Vector2.new(vector.X, vector.Y + height / 2)
                else
                    tracer.Visible = false
                end
            else
                box.Visible = false
                tracer.Visible = false
            end
        else
            box.Visible = false
            tracer.Visible = false
        end
    end
end))

-- ============================================================================
-- УПРАВЛЕНИЕ ПАМЯТЬЮ И ОЧИСТКА
-- ============================================================================

LocalPlayer.PlayerRemoving:Connect(function(player)
    if player == LocalPlayer then
        for _, conn in ipairs(Connections) do
            if conn.Connected then
                conn:Disconnect()
            end
        end
        for playerObj, _ in pairs(ESPFolder) do
            removeESP(playerObj)
        end
    end
end)

